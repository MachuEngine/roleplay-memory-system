{
  "_note": "캐릭터의 행동·대사로 생기는 상태 변화 추출 정답. 캐릭터 응답은 실행마다 달라지므로 합성 대화로 고정했다. 캐릭터와 사용자는 demo/sample_character.json(서리/하람). required는 추출 뒤 L1에 있어야 하는 '항목: 값' 패턴, forbidden은 있으면 안 되는 패턴, pre_facts는 추출 전에 이미 L1에 있는 항목이다.",
  "cases": [
    {
      "id": "S1-선물",
      "turns": [
        ["하람", "*카운터에 기대 책장을 둘러봤다.* \"그 시집 아직 못 찾았어?\""],
        ["서리", "*말없이 카운터 아래 서랍을 열어 낡은 시집 한 권을 꺼냈다. 그리고 하람 앞에 툭 내려놓았다.* \"……가져가. 돈은 됐어.\""],
        ["하람", "*시집을 받아 들고 표지를 쓸었다.* \"진짜? 고마워.\""]
      ],
      "required": [{"name": "시집 소유 이동", "match": "^소유.*시집.*하람|^소유.*하람.*시집|^소유\\(시집\\).*하람"}],
      "forbidden": []
    },
    {
      "id": "S2-호칭",
      "turns": [
        ["하람", "\"오늘도 '너'라고 부를 거야? 내 이름 알잖아.\""],
        ["서리", "*잠시 입을 다물었다가, 처음으로 이름을 불렀다.* \"……하람. 됐냐.\""]
      ],
      "required": [{"name": "호칭 변화", "match": "^호칭.*하람"}],
      "forbidden": []
    },
    {
      "id": "S3-약속 수락",
      "turns": [
        ["하람", "\"이번 달 말에 마감 끝나면 같이 바다 보러 가자.\""],
        ["서리", "*창밖을 한참 보다가 고개를 끄덕였다.* \"……그래. 가자. 마감이나 끝내.\""]
      ],
      "required": [
        {"name": "약속 내용", "match": "^약속\\(.*(마감|이번 달)"},
        {"name": "약속 수락", "match": "^약속상태.*(수락|받아|가기로|동의|승낙|그래)"}
      ],
      "forbidden": []
    },
    {
      "id": "S4-약속 취소",
      "pre_facts": [
        ["약속(바다)", "이번 달 말 마감 후 같이 가기", 0],
        ["약속상태(바다)", "서리가 받아들임", 1]
      ],
      "turns": [
        ["하람", "\"다음 주에 바다 가는 거 맞지?\""],
        ["서리", "*한숨을 쉬며 달력을 가리켰다.* \"못 가. 그 주에 책방 정리해야 돼. 미안.\""]
      ],
      "required": [{"name": "약속 취소", "match": "^약속상태.*(취소|못|거절|미루|무산|어렵)"}],
      "forbidden": [{"name": "수락 상태 유지", "match": "^약속상태.*받아들임$"}]
    },
    {
      "id": "S5-생각만 함",
      "turns": [
        ["하람", "\"그 시집 있으면 좋겠다.\""],
        ["서리", "*서랍 속 시집을 건네주고 싶었지만, 결국 서랍을 다시 닫았다.* \"……없어.\""]
      ],
      "required": [],
      "forbidden": [{"name": "건네지 않은 선물을 소유 이동으로 기록", "match": "^소유"}]
    },
    {
      "id": "S6-설정 습관 반복",
      "turns": [
        ["하람", "\"오늘 손님 없네.\""],
        ["서리", "*손님이 없을 때면 늘 그렇듯 창가 자리에서 식은 커피를 마셨다.* \"늘 이래.\""]
      ],
      "required": [],
      "forbidden": [{"name": "설정 습관을 상태로 기록", "match": "커피|창가"}]
    },
    {
      "id": "S7-화해",
      "turns": [
        ["하람", "\"지난번엔 내가 너무했어. 미안.\""],
        ["서리", "*오래 굳어 있던 어깨가 조금 풀렸다.* \"……나도. 이제 됐어.\""]
      ],
      "required": [{"name": "관계 회복", "match": "^관계.*(화해|풀|용서|사과|회복)"}],
      "forbidden": []
    },
    {
      "id": "S8-사용자 사실 보호",
      "pre_facts": [["생일(하람)", "다음 주 목요일", 0]],
      "turns": [
        ["하람", "\"나 생일 선물 기대해도 돼?\""],
        ["서리", "\"네 생일 금요일 아니었나. ……뭐, 아무튼.\""]
      ],
      "required": [{"name": "기존 생일 유지", "match": "^생일\\(하람\\).*목요일"}],
      "forbidden": [{"name": "캐릭터 발언으로 생일 변경", "match": "^생일.*금요일"}]
    }
  ]
}
